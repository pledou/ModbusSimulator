{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "node",
    "allowImportingTsExtensions": true
  },
  "include": [
    "test/**/*"
  ],
  "exclude": [],
  "ts-node": {
    "esm": true,
    "experimentalEsm": true,
    "transpileOnly": true,
    "compilerOptions": {
      "module": "ES2020"
    },
    "experimentalResolver": true
  }
}
