{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2020",
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": false,
        "allowJs": true,
        "checkJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmitOnError": false,
        "isolatedModules": false,
        "moduleResolution": "node",
        "baseUrl": "./",
        "outDir": "./",
        "paths": {
            "json-ref-lite": ["node_modules/json-ref-lite"],
            "json5": ["node_modules/json5"]
        }
    },
    "include": [
        "src/**/*.ts",
        "*.ts"
    ],
    "typeRoots": [
        "node_modules/@types"
    ],
    "exclude": [
        "node_modules",
        "test/**"
    ]
}